# Anthropic Claude — strategy, content, outreach, reports
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# DataForSEO — keyword research, SERP, backlinks
# Basic Auth credentials from: https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google APIs — OAuth 2.0 via googleapis
# One OAuth client (Client ID + Secret) from: https://console.cloud.google.com/apis/credentials
# Two refresh tokens — one per Google account the tool authenticates with:
#   - GOOGLE_REFRESH_TOKEN_PARTNERS:    drives the existing partner pipeline
#                                       (Reporting, Keyword Research, etc.)
#   - GOOGLE_REFRESH_TOKEN_ASSESSMENTS: drives the Assessment workflow
#                                       (Audit + Competitive Analysis tabs)
# Generate each token via the OAuth consent flow at /api/gsc/auth (sign in
# as the matching account each time) or scripts/oauth-setup.js --label <name>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN_PARTNERS=
GOOGLE_REFRESH_TOKEN_ASSESSMENTS=
# Email addresses are surfaced in error messages so prospects know who to
# share GSC/GA4 access with. Replace with the real Harbinger-owned addresses.
GOOGLE_PARTNERS_EMAIL=access@harbingermarketing.com
GOOGLE_ASSESSMENTS_EMAIL=audit@harbingermarketing.com

# Airtable — partner records (read-only for MVP)
# PAT from: https://airtable.com/create/tokens (scopes: data.records:read, schema.bases:read)
# Base ID from the Airtable URL (appXXXXXXXXXXXXXX). Table name is the literal table name.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_PARTNERS_TABLE=

# App-level password gate (single-user auth; see CLAUDE.md → Auth).
# APP_PASSWORD: the password you type at /login. Anything strong is fine.
# APP_AUTH_SECRET: HMAC signing key for the session cookie. Must be at least
# 32 bytes of randomness. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_PASSWORD=
APP_AUTH_SECRET=

# Vercel Blob storage — used only by the SEO Audit tab to host generated PDF
# reports. Create a Blob store in the Vercel dashboard (Storage → Create →
# Blob), name it "audit-reports", and Vercel will auto-populate this env
# var when you connect the store to this project. The rest of the app works
# without this set.
BLOB_READ_WRITE_TOKEN=
